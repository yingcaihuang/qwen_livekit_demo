# LiveKit Server Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Database Configuration
DB_PATH=./data/voice_admin.db

# Server Configuration
PORT=8090
# Azure OpenAI Configuration (chat / image testing)
# Azure OpenAI API versions (read from config, not hardcoded)
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Data storage
# Root directory for persisted data (should be consistent with DB_PATH location)
DATA_DIR=./data
# Sub-directory under DATA_DIR for generated image files
IMAGES_DIR_NAME=images
# Max size (in bytes) allowed for an uploaded reference image (default 50MB)
MAX_REFERENCE_IMAGE_BYTES=52428800

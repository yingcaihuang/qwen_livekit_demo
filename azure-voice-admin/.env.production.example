# ============================================================
# Azure Voice Testing Admin - 环境变量配置
# ============================================================
# 复制此文件为 .env.production 并填写你的配置：
#   cp .env.production.example .env.production
# ============================================================

# ----------------------------------------------------------
# LiveKit 凭据（必须与 livekit.yaml 中的 keys 一致）
# Secret 必须至少 32 个字符
# ----------------------------------------------------------
LIVEKIT_API_KEY=APIKeyForVoiceAdmin
LIVEKIT_API_SECRET=ThisIsASecretThatIsAtLeast32CharsLong!

# ----------------------------------------------------------
# 域名配置
# ----------------------------------------------------------
# 内网/本地测试模式（默认）— 纯 HTTP，无需域名
SITE_DOMAIN=:80

# 客户端连接 LiveKit 的公网地址
# 内网模式下使用 ws://（WebSocket）
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ----------------------------------------------------------
# 公网生产部署时，修改为：
# SITE_DOMAIN=livekit.verycloud.cn
# LIVEKIT_PUBLIC_URL=wss://rtc.verycloud.cn:7880
#
# 说明：
# - SITE_DOMAIN: Caddy 监听的域名，设为域名后自动启用 HTTPS
# - LIVEKIT_PUBLIC_URL: 浏览器连接 LiveKit 的地址
#   生产环境需要 wss:// 协议和公网可达的域名/端口
# ----------------------------------------------------------

# ============================================================
# Azure Voice Testing Admin - 环境变量配置
# ============================================================
# 复制此文件为 .env.production 并填写你的配置：
#   cp .env.production.example .env.production
# ============================================================

# ----------------------------------------------------------
# LiveKit 凭据（被 backend 和 livekit 服务共同使用）
# 修改后两边自动同步，无需手动编辑 livekit.yaml
# Secret 必须至少 32 个字符
# ----------------------------------------------------------
LIVEKIT_API_KEY=APIKeyForVoiceAdmin
LIVEKIT_API_SECRET=ThisIsASecretThatIsAtLeast32CharsLong!

# ----------------------------------------------------------
# 域名配置
# ----------------------------------------------------------
# 内网/本地测试模式（默认）— 纯 HTTP，无需域名
SITE_DOMAIN=:80
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ----------------------------------------------------------
# 公网生产部署时，修改为：
# SITE_DOMAIN=livekit.verycloud.cn
# RTC_DOMAIN=rtc.verycloud.cn
# LIVEKIT_PUBLIC_URL=wss://rtc.verycloud.cn
#
# 说明：
# - SITE_DOMAIN: Caddy 监听的主站域名，自动 HTTPS
# - RTC_DOMAIN: Caddy 监听的 RTC 域名，代理到 LiveKit（WSS 终止）
# - LIVEKIT_PUBLIC_URL: 浏览器连接 LiveKit 的地址（通过 Caddy WSS 代理）
# - LIVEKIT_API_KEY / LIVEKIT_API_SECRET: 同时用于 backend JWT 签发和 LiveKit 验证
# ----------------------------------------------------------
